<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_load_limayrac_demo" model="ir.cron">
            <field name="name">Limayrac : charger les données de démo</field>
            <field name="model_id" ref="model_limayrac_demo_loader"/>
            <field name="state">code</field>
            <field name="code">model.load_demo_data()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <!-- Prochaine exécution très lointaine : le cron reste visible et
                 déclenchable manuellement, mais ne tourne jamais tout seul. -->
            <field name="nextcall">2100-01-01 00:00:00</field>
        </record>
    </data>
</odoo>
