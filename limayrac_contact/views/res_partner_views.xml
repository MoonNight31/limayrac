<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_res_partner_form_limayrac_contact" model="ir.ui.view">
            <field name="name">res.partner.form.limayrac.contact</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='parent_id']" position="after">
                    <field name="birthday_date" invisible='is_company'/>
                    <field name="headquarters_id" invisible="not is_company"/>
                </xpath>
                <xpath expr="//page[@name='contact_addresses']" position="attributes">
                    <attribute name="invisible">not is_company</attribute>
                </xpath>
                <xpath expr="//page[@name='internal_notes']" position="before">
                    <page name="services" string="Services" invisible='not is_company'>
                        <field name="res_partner_department_ids">
                            <list decoration-danger="is_blacklisted" editable="bottom">
                                <field name="name" readonly="is_blacklisted"></field>
                                <field name="res_partner_id" column_invisible='1'></field>
                                <field name="is_blacklisted" column_invisible='1'></field>
                                <field name="tags_ids" widget="many2many_tags" readonly="is_blacklisted" create="1" quick_create="1"></field>
                                <field name="reason_blacklist" readonly="1"></field>
                                <button name="action_blacklist" invisible="is_blacklisted" string="Blacklist" type="object" class="btn-primary"></button>
                                <button name="action_unblacklist" invisible="not is_blacklisted" string="Unblacklist" type="object" class="btn-secondary"></button>
                            </list>
                        </field>
                    </page>
                    <page name="subsidiaries" string="Filiales" invisible="not is_company">
                        <field name="childs_company_ids" readonly="1" nolabel="1">
                            <kanban>
                                <templates>
                                    <t t-name="card">
                                        <div class="fw-bold"><field name="name"/></div>
                                        <div><field name="vat"/></div>
                                        <div><field name="company_registry"/></div>
                                        <div><field name="res_partner_naf_id"/></div>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </page>
                    <page name="cursus" string="Cursus" invisible="is_company">
                        <field name="res_partner_cursus_ids">
                            <list editable="bottom">
                                <field name="limayrac_formations_id"/>
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="is_diploma_obtained"/>
                            </list>
                        </field>
                    </page>
                    <page name="limayrac_formations" string="Formations Limayrac" invisible="not limayrac_formations_ids">
                        <field name="limayrac_formations_ids" readonly="1">
                            <list>
                                <field name="name"/>
                                <field name="title_rncp_id"/>
=                            </list>
                        </field>
                    </page>
                </xpath>
                <xpath expr="//field[@name='vat']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='vat']" position="after">
                    <field name="partner_type_ids" string="Type de contact" invisible="is_company" widget="many2many_checkboxes"/>
                    <field name="company_registry" string="SIREN/SIRET" invisible="parent_id or not is_company" options="{'placeholder_field': 'company_registry_placeholder'}"/>
                    <field name="industry_id" invisible="not is_company" options="{'no_create': True}"/>
                    <field name="res_partner_naf_id" invisible="not is_company"/>
                </xpath>
                <xpath expr="//group[@name='misc']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//page[@name='sales_purchases']" position="attributes">
                    <attribute name="invisible">not is_company</attribute>
                </xpath>
                <xpath expr="//sheet/group[1]" position="after">
                    <group name="company_information" string="Informations entreprise" invisible='not is_company'>
                        <field name="is_partenaire" string="Partenaire" invisible="1"/>
                        <field name="is_prospect" string="Prospect"/>
                        <field name="is_blacklist" string="Blacklist"/>
                    </group>
                </xpath>                
            </field>
        </record>
        <record id="res_partner_view_search_limayrac_contact" model="ir.ui.view">
            <field name="name">res.partner.select.limayrac.contact</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_res_partner_filter"/>
            <field name="arch" type="xml">
                
                <xpath expr="//filter[@name='type_company']" position="after">
                    <filter string='Formateurs' name='partner_type_formateurs' domain="[('partner_type_ids.code', '=', 'type_001')]"/>
                    <filter string='Étudiants' name='partner_type_etudiants' domain="[('partner_type_ids.code', '=', 'type_002')]"/>
                    <filter string='Administratifs' name='partner_type_administratifs' domain="[('partner_type_ids.code', '=', 'type_003')]"/>
                    <filter string='Entreprises' name='partner_type_entreprises' domain="[('partner_type_ids.code', '=', 'type_004')]"/>
                    <filter string='Anciens étudiants' name='partner_type_anciens_etudiants' domain="[('partner_type_ids.code', '=', 'type_005')]"/>
                </xpath>

                <xpath expr="//group[@name='group_by']" position="inside">
                    <filter name='limayrac_formations_ids' string="Enseignants par formations" domain="[('limayrac_formations_ids', '!=', False), ('partner_type_ids.code', '=', 'type_001')]" context="{'group_by' : 'limayrac_formations_ids'}"/>
                    <filter name='cursus_formations_ids' string="Élèves par formations" domain="[('cursus_formations_ids', '!=', False), ('partner_type_ids.code', '=', 'type_002')]" context="{'group_by' : 'cursus_formations_ids'}"/>
                    <filter name='partner_type_ids' string="Type de contact" domain="[('partner_type_ids', '!=', False)]" context="{'group_by' : 'partner_type_ids'}"/>
                </xpath>
                <xpath expr="//filter[@name='type_person']" position="replace"/>
                <xpath expr="//filter[@name='type_company']" position="replace"/>
                <xpath expr="//filter[@name='salesperson']" position="replace"/>
                <xpath expr="//filter[@name='group_country']" position="replace"/>
                <xpath expr="//filter[@name='group_by_properties']" position="replace"/>
            </field>
        </record>
    </data>
</odoo>