<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record id="view_res_partner_form_limayrac_contact" model="ir.ui.view">
            <field name="name">res.partner.form.limayrac.contact</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='parent_id']" position="after">
                    <field name="headquarters_id" invisible="not is_company"/>
                    <field name="birthday_date"/>
                </xpath>
                <xpath expr="//field[@name='company_registry']" position="after">
                    <field name="res_partner_naf_id" invisible="not is_company"/>
                </xpath>
                <xpath expr="//page[@name='internal_notes']" position="after">
                    <page name="services" string="Services">
                        <field name="res_partner_department_ids"/>
                    </page>
                    <page name="subsidiaries" string="Filiales" invisible="not is_company">
                        <field name="childs_company_ids">
                            <kanban>
                                <templates>
                                    <t t-name="card">
                                        <div class="fw-bold"><field name="name"/></div>
                                        <div><field name="vat"/></div>
                                        <div><field name="company_registry"/></div>
                                        <div><field name="res_partner_naf_id"/></div>
                                    </t>
                                </templates>
                            </kanban>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
        
    
    </data>
    

</odoo>
