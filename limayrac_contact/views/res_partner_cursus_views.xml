<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_res_partner_cursus_list" model="ir.ui.view">
            <field name="name">res.partner.cursus.list</field>
            <field name="model">res.partner.cursus</field>
            <field name="arch" type="xml">
                <list editable="bottom" default_order="start_date desc">
                    <field name="res_partner_id"/>
                    <field name="formation_id" required="not limayrac_formations_id"/>
                    <field name="limayrac_formations_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="is_diploma_obtained"/>
                </list>
            </field>
        </record>
        <record id="view_res_partner_cursus_search" model="ir.ui.view">
            <field name="name">res.partner.cursus.search</field>
            <field name="model">res.partner.cursus</field>
            <field name="arch" type="xml">
                <search>
                    <field name="res_partner_id"/>
                    <field name="formation_id"/>
                    <field name="limayrac_formations_id"/>
                    <filter name="current" string="En cours"
                            domain="['|', ('end_date', '=', False), ('end_date', '&gt;=', context_today().strftime('%Y-%m-%d'))]"/>
                    <filter name="diploma" string="Diplôme obtenu" domain="[('is_diploma_obtained', '=', True)]"/>
                    <group>
                        <filter name="group_formation" string="Formation" context="{'group_by': 'formation_id'}"/>
                        <filter name="group_class" string="Classe" context="{'group_by': 'limayrac_formations_id'}"/>
                        <filter name="group_start" string="Date de début" context="{'group_by': 'start_date:year'}"/>
                    </group>
                </search>
            </field>
        </record>
        <record id="action_res_partner_cursus" model="ir.actions.act_window">
            <field name="name">Cursus</field>
            <field name="res_model">res.partner.cursus</field>
            <field name="view_mode">list</field>
        </record>
        <menuitem id="menu_res_partner_cursus"
            name="Cursus"
            parent="contacts.menu_contacts"
            action="action_res_partner_cursus"
            sequence="10"/>
    </data>
</odoo>
