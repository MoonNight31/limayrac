<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_limayrac_formations_list" model="ir.ui.view">
            <field name="name">limayrac.formations.list</field>
            <field name="model">limayrac.formations</field>
            <field name="arch" type="xml">
                <list string="Formations Limayrac">
                    <field name="name"/>
                    <field name="title_rncp_id"/>
                    <field name="question_one"/>
                    <field name="question_two"/>
                    <field name="question_three"/>
                    <field name="question_four"/>
                    <field name="question_five"/>
                </list>
            </field>
        </record>

        <record id="view_limayrac_formations_form" model="ir.ui.view">
            <field name="name">limayrac.formations.form</field>
            <field name="model">limayrac.formations</field>
            <field name="arch" type="xml">
                <form string="Formations Limayrac">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="question_one"/>
                            <field name="question_two"/>
                            <field name="question_three"/>
                            <field name="question_four"/>
                            <field name="question_five"/>
                            <field name="title_rncp_id"/>
                        </group>
                        <notebook>
                            <page name="title_rncp" string="Ancien titre RNCP associé">
                                <group>
                                    <field name="old_rncp_ids" readonly="1" nolabel="1">
                                        <list decoration-danger="not is_valid">
                                            <field name="name"/>
                                            <field name="code_rncp"/>
                                            <field name="is_valid"/>
                                        </list>
                                    </field>
                                </group>
                            </page>
                            <page name="responsables_pedagogiques" string="Responsables pédagogiques">
                                <field name="res_partner_ids">
                                    <kanban>
                                        <templates>
                                            <t t-name="card">
                                                <div class="fw-bold"><field name="name"/></div>
                                            </t>
                                        </templates>
                                    </kanban>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_limayrac_formations" model="ir.actions.act_window">
            <field name="name">Formations</field>
            <field name="res_model">limayrac.formations</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Créez votre première formation
                </p>
            </field>
        </record>

        <menuitem id="menu_limayrac_formations"
            name="Formations"
            parent="contacts.menu_contacts"
            action="action_limayrac_formations"
            sequence="10"/>
    </data>
</odoo>