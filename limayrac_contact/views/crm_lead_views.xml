<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_crm_lead_form_limayrac" model="ir.ui.view">
            <field name="name">crm.lead.form.limayrac</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">

            <xpath expr="//span[@class='opacity-50 p-2'][@groups='!crm.group_use_recurring_revenues']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//span[@class='opacity-50 p-2 text-nowrap d-none d-sm-block']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//div[@class='col-auto']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_contracts" type="object"
                        class="oe_stat_button" icon="fa-file-text-o"
                        invisible="contract_count == 0">
                    <field name="contract_count" widget="statinfo" string="Contrats"/>
                </button>
            </xpath>

            <xpath expr="//header" position="inside">
                <button name="action_create_contract" type="object"
                        string="Créer un contrat" class="oe_highlight"
                        invisible="not res_partner_id"/>
            </xpath>
            
            <xpath expr="//field[@name='stage_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <field name="type_contract" widget="radio" options="{'horizontal': true}"/>
            </xpath>

            <xpath expr="//div[@class='d-flex gap-3 align-items-center']" position="after">
                <field name="res_partner_id"/>
            </xpath>

            <xpath expr="//button[@name='action_set_won_rainbowman']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//page[@name='internal_notes']" position="before">
                    <page name="candidatures" string="Candidatures">
                            <field name="res_partner_ids" widget="many2many">
                            <list>
                                <field name="name"/>
                            </list>
                            </field>
                    </page>
            </xpath>
            <xpath expr="//page[@name='internal_notes']" position="before">
                    <page name="formations" string="Formations Limayrac">
                            <field name="limayrac_formation_ids" widget="many2many">
                            <list>
                                <field name="name"/>
                                <field name="title_rncp_id"/>
                            </list>
                            </field>
                    </page>
            </xpath>
            </field>
        </record>
    </data>
</odoo>